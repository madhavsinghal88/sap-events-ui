# Copy to .env.local and fill in your values:
# cp .env.example .env.local

# Local dev server (Next.js reads PORT/HOSTNAME; browser import uses LOCAL_*)
LOCAL_HOST=localhost
LOCAL_PORT=8881
PORT=8881
HOSTNAME=localhost
# Optional: override full base URL (e.g. http://127.0.0.1:8881)
# LOCAL_APP_URL=

# Supabase (required for Vercel deployment)
# Get these from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron Authentication Secret
# Match this with Vercel Cron settings for secure scheduler triggers
CRON_SECRET=
