# Copy to .env.local and fill in your values:
# cp .env.example .env.local

# Local dev server (Next.js reads PORT/HOSTNAME; browser import uses LOCAL_*)
LOCAL_HOST=localhost
LOCAL_PORT=8881
PORT=8881
HOSTNAME=localhost
# Optional: override full base URL (e.g. http://127.0.0.1:8881)
# LOCAL_APP_URL=

# Google Sheet ID from the sheet URL:
# https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Optional: custom path to service account JSON
# Default is credentials/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
